// Real-model study of explanations for WEAK-graded moves, graded by REAL Stockfish exactly as the app does (best move at 500 ms, then a
// depth-14 search of the position after the move whose final bestmove is the opponent's reply). Games are generated by playing moves
// from Stockfish's top-6 at random so there is a mix of inaccuracies, mistakes and blunders, both colours, captures, checks and quiet
// moves. Each weak move is sent to the REAL configured explanation endpoint and the outcome is classified:
//   accepted     = the model's text passed every check (this does NOT prove it is chess-accurate)
//   evidence     = the text was rejected and the engine-verified downside sentence is shown instead
//   unavailable  = the text was rejected and no downside was proven: grade + "Explanation unavailable."
// BASE_URL=http://localhost:3100 npx tsx scripts/real-weak-moves-study.mts   (server started with CHESS_EXPLAIN_DEBUG=1 to see reasons)
import { spawn } from 'node:child_process'
import { mkdirSync, writeFileSync } from 'node:fs'
import { Chess } from 'chess.js'
import { buildEvidence, buildMoveFacts, describeDownside, resolveExplanation, type Grade } from '../src/lib/chess/moveFacts'
import { classifyMove } from '../src/lib/chess/moveClassification'

const BASE = process.env.BASE_URL ?? 'http://localhost:3100'
const WANT = Number(process.env.WANT ?? 28)
// MODE=targeted picks from the engine's LOWER-ranked moves so that moves which really lose material are well represented (the
// representative mode plays mostly sound moves, where weak grades rarely come with a material loss). The two are reported separately.
const MODE = process.env.MODE === 'targeted' ? 'targeted' : 'representative'
const TAG = MODE

class Engine {
  p = spawn('node', ['public/stockfish/stockfish-18-lite-single.js'])
  buf = ''
  constructor() {
    this.p.stdout.on('data', (d) => { this.buf += d })
  }
  send(cmd: string, until: RegExp): Promise<string> {
    return new Promise((res) => {
      this.p.stdin.write(cmd + String.fromCharCode(10))
      const tick = () => { if (until.test(this.buf)) { const b = this.buf; this.buf = ''; res(b) } else setTimeout(tick, 15) }
      tick()
    })
  }
  async init() { await this.send('uci', /uciok/); await this.send('isready', /readyok/) }
  async top(fen: string, n: number, movetime: number) {
    this.p.stdin.write(`setoption name MultiPV value ${n}\n`)
    this.p.stdin.write(`position fen ${fen}\n`)
    const out = await this.send(`go movetime ${movetime}`, /bestmove/)
    const lines = new Map<number, { move: string; cp: number }>()
    for (const l of out.split('\n')) {
      const m = l.match(/multipv (\d+) .*score (cp|mate) (-?\d+).* pv (\S+)/)
      if (m && /depth/.test(l)) lines.set(Number(m[1]), { move: m[4], cp: m[2] === 'mate' ? Math.sign(Number(m[3])) * 100000 : Number(m[3]) })
    }
    return [...lines.entries()].sort((a, b) => a[0] - b[0]).map((x) => x[1])
  }
  async after(fen: string, depth: number) {
    this.p.stdin.write('setoption name MultiPV value 1\n')
    this.p.stdin.write(`position fen ${fen}\n`)
    const out = await this.send(`go depth ${depth}`, /bestmove/)
    let cp = 0
    let pv: string[] = []
    for (const l of out.split('\n')) {
      const m = l.match(/score (cp|mate) (-?\d+)/)
      if (m) cp = m[1] === 'mate' ? Math.sign(Number(m[2])) * 100000 : Number(m[2])
      const p = l.match(/ pv (.+)$/)
      if (p) pv = p[1].trim().split(/\s+/)
    }
    return { cp, reply: out.match(/bestmove (\S+)/)?.[1], pv }
  }
  quit() { this.p.kill() }
}

const openings = [[], ['e4', 'e5', 'Nf3', 'Nc6', 'Bc4'], ['d4', 'd5', 'c4', 'e6'], ['e4', 'c5'], ['Nf3', 'Nf6', 'g3'], ['e4', 'e6', 'd4', 'd5']]
const sample: <T>(a: T[]) => T = (a) => a[Math.floor(Math.random() * a.length)]

const eng = new Engine()
await eng.init()
interface Row { n: number; game: string; moveNo: string; color: string; san: string; kind: string[]; grade: Grade; outcome: string; reason?: string; replySan?: string; shown: string; gradeMs?: number; commentaryMs?: number; modelCalled?: boolean; verifiedLoss?: boolean; netMaterial?: number; line?: string; fixture?: unknown }
const rows: Row[] = []
const counts: Record<string, number> = {}
let guard = 0
while (rows.length < WANT && guard++ < 40) {
  const g = new Chess()
  const op = sample(openings)
  for (const m of op) g.move(m)
  for (let ply = op.length; ply < 44 && !g.isGameOver() && rows.length < WANT; ply++) {
    const fenBefore = g.fen()
    const top = await eng.top(fenBefore, MODE === 'targeted' ? 10 : 6, 250)
    if (top.length === 0) break
    // mostly play sound moves, sometimes a weaker one: gives a spread of grades
    const pick = MODE === 'targeted' ? (Math.random() < 0.8 ? top[Math.max(0, top.length - 1 - Math.floor(Math.random() * 4))] : top[0]) : Math.random() < 0.55 ? top[Math.min(top.length - 1, 1 + Math.floor(Math.random() * 5))] : top[0]
    const best = top[0]
    const move = g.move({ from: pick.move.slice(0, 2), to: pick.move.slice(2, 4), promotion: pick.move[4] })
    if (!move) break
    const fenAfter = g.fen()
    const best500 = (await eng.top(fenBefore, 1, 500))[0] ?? best
    const t0 = Date.now()
    const aft = await eng.after(fenAfter, 14)
    const gradeMs = Date.now() - t0
    const cpLoss = Math.max(0, best500.cp - -aft.cp)
    const grade = classifyMove(cpLoss, best500.move === pick.move) as Grade
    if (!['inaccuracy', 'mistake', 'blunder'].includes(grade)) continue
    const kinds = [move.captured ? 'capture' : 'quiet', move.san.includes('+') || move.san.includes('#') ? 'check' : '', move.color === 'w' ? 'White' : 'Black'].filter(Boolean)
    const keyKind = `${kinds[0]}${kinds.includes('check') ? '+check' : ''}/${move.color}`
    if ((counts[keyKind] ?? 0) >= 5) continue // keep the sample varied
    counts[keyKind] = (counts[keyKind] ?? 0) + 1
    const history = g.history().slice(0, -1)
    const facts = buildMoveFacts({ fenBefore, fenAfter, san: move.san, ply, historySan: history })
    if (!facts) continue
    const ev = buildEvidence(facts, { grade, pvUci: aft.pv.slice(0, 10), replyUci: aft.reply })
    const body = { fen: fenBefore, move: move.san, classification: grade, evalBefore: best500.cp, evalAfter: -aft.cp, tone: 'simple', depth: 'rich', recentMovesSan: history.slice(-5), fenAfter, ply, historySan: history.slice(-8), replyUci: aft.reply, pvUci: aft.pv.slice(0, 10) }
    const t1 = Date.now()
    let status = 0
    let data: Record<string, unknown> = {}
    try {
      const res = await fetch(`${BASE}/api/chess/explain-move`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      status = res.status
      data = (await res.json()) as Record<string, unknown>
    } catch (e) { data = { error: String(e) } }
    const commentaryMs = Date.now() - t1
    const fields = status === 200 && data.source !== 'rejected' ? [data.headline as string, data.explanation as string, ...((data.bullets as string[]) ?? []), data.suggestion as string, data.notice as string] : null
    const r = resolveExplanation(fields, facts, ev)
    const outcome = status !== 200 ? 'service-error' : r.kind === 'model' ? 'accepted' : r.kind
    rows.push({
      n: rows.length + 1, game: [...op].join(' '), moveNo: facts.notation, color: move.color === 'w' ? 'White' : 'Black', san: move.san, kind: kinds, grade, outcome,
      reason: (data.reason as string) ?? (r.kind !== 'model' ? r.reason : undefined), replySan: ev.replySan, gradeMs, commentaryMs,
      modelCalled: !(data.reason === 'no-verified-downside'), verifiedLoss: describeDownside(facts, ev) !== null, netMaterial: ev.netMaterial, line: ev.line.join(' '),
      fixture: { source: 'real-weak-moves-study (captured with real Stockfish + the real model; SUBSTITUTE positions, not the reviewed games)', fenBefore, san: move.san, ply, historySan: history.slice(-8), grade, pvUci: aft.pv.slice(0, 10), returned: { headline: data.headline, explanation: data.explanation, bullets: data.bullets, suggestion: data.suggestion, source: data.source, reason: data.reason, rawText: data.rawText }, validation: { kind: r.kind, reason: r.kind === 'model' ? undefined : r.reason } },
      shown: r.kind === 'model' ? [data.headline, data.explanation, ...((data.bullets as string[]) ?? []), data.suggestion].filter(Boolean).join(' | ') : r.kind === 'evidence' ? r.text : 'Explanation unavailable.',
    })
    console.error(`${rows.length}/${WANT} ${facts.notation} ${grade} -> ${outcome}${rows.at(-1)!.reason ? ` (${rows.at(-1)!.reason})` : ''}`)
  }
}
eng.quit()
const pct = (xs: number[], p: number) => (xs.length ? [...xs].sort((a, b) => a - b)[Math.min(xs.length - 1, Math.floor(p * xs.length))] : null)
const tally = (k: (r: Row) => string) => rows.reduce<Record<string, Record<string, number>>>((a, r) => { const x = (a[k(r)] ??= {}); x[r.outcome] = (x[r.outcome] ?? 0) + 1; return a }, {})
const summary = {
  checkedAt: new Date().toISOString(), base: BASE, moves: rows.length,
  mode: MODE,
  note: 'Real Stockfish grading + the real configured model, one call per weak move. "accepted" means the text passed the automated checks, NOT that it is proven chess-accurate: see manualReview in the report.',
  totals: tally(() => 'all'), byGrade: tally((r) => r.grade), byKind: tally((r) => r.kind[0] + (r.kind.includes('check') ? '+check' : '')), byColour: tally((r) => r.color),
  modelCalls: rows.filter((r) => r.modelCalled).length, modelSkippedBecauseNoVerifiedLoss: rows.filter((r) => !r.modelCalled).length, withVerifiedLoss: rows.filter((r) => r.verifiedLoss).length,
  latencyMs: { grading: { median: pct(rows.map((r) => r.gradeMs ?? 0), 0.5), p95: pct(rows.map((r) => r.gradeMs ?? 0), 0.95) }, commentary: { median: pct(rows.filter((r) => r.modelCalled).map((r) => r.commentaryMs ?? 0), 0.5), p95: pct(rows.filter((r) => r.modelCalled).map((r) => r.commentaryMs ?? 0), 0.95) } },
  rows: rows.map(({ fixture, ...r }) => (void fixture, r)),
}
mkdirSync('tests/fixtures/review-evidence', { recursive: true })
writeFileSync(`tests/fixtures/review-evidence/real-weak-moves-${TAG}.json`, JSON.stringify(rows.map((r) => r.fixture), null, 1))
writeFileSync(`docs/chess-real-weak-moves-study-${TAG}.json`, JSON.stringify(summary, null, 2))
console.log(JSON.stringify({ totals: summary.totals, byGrade: summary.byGrade, byKind: summary.byKind, byColour: summary.byColour }, null, 1))
