# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Anthropic (existing — chess move explanations)
ANTHROPIC_API_KEY=

# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# This project uses Supabase's current publishable/secret key naming, not the
# older anon/service_role split.
SUPABASE_URL=https://your-project-ref.supabase.co
# Client-safe key — used for public reads (tournaments query layer, admin page reads).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# SERVER-ONLY — bypasses RLS. Never expose to the browser. Used by the puzzle
# import script and the admin tournaments page's write actions.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Used for JWT verification once real auth is wired up. Not read by any code yet.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Shared password gating /admin/tournaments (a stopgap, not real auth — see
# that page's comments). Pick any non-trivial value.
ADMIN_TOURNAMENTS_PASSWORD=

# Shared password gating /admin/feedback (the NIVENXA Feedback dashboard —
# same stopgap pattern as above, deliberately a separate password so a leak
# of one doesn't open the other).
ADMIN_FEEDBACK_PASSWORD=

# Nivenxa Living (/living) — real per-user sessions via Supabase Auth, so
# unlike the vars above these two ARE exposed to the browser (NEXT_PUBLIC_).
# That's safe: same project, same publishable key, RLS decides what it can
# actually read/write (see supabase/living_schema.sql). Same values as
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY above — just re-declared under the
# NEXT_PUBLIC_ prefix Next.js requires to ship a var to client components.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Phone OTP at /living/signup and /living/login only sends real SMS once an
# SMS provider (e.g. MSG91, Twilio) is configured under Authentication ->
# Providers -> Phone in the Supabase dashboard — that's a console step, not
# an env var, and isn't required for the email OTP path to work.
